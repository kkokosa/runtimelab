# Build outputs
native/obj/
native/x64/
native/*.pdb
native/*.ilk
native/*.exp
native/*.lib
native/*.obj
native/tools/*.exe
native/tools/*.obj
native/tools/*.dll

# Sample app build/publish output (regenerate via build.ps1 + dotnet publish)
samples/**/bin/
samples/**/obj/
samples/**/publish/

# Raw benchmark dumps (keep report.html, regenerate json via run-benchmarks.ps1)
results/*.dmp

results/raw/dotnet-counters.log
results/raw/*.pauselog

# Out-of-process trace captures (regenerate via capture-lxr-trace.ps1)
results/trace/
results/phase-report.html

# TraceAnalyzer offline tool build output (source under tools/ is tracked)
tools/**/bin/
tools/**/obj/

# Local copy of the LXR paper (arXiv:2210.17175) for offline reference - do not commit
paper/

