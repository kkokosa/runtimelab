# Build outputs
native/obj/
native/x64/
native/*.pdb
native/*.ilk
native/*.exp
native/*.lib
native/*.obj
native/tools/*.exe
native/tools/*.obj
native/tools/*.dll

# Sample app build/publish output (regenerate via build.ps1 + dotnet publish)
samples/**/bin/
samples/**/obj/
samples/**/publish/

# Raw benchmark dumps (keep report.html + results-full.json, regenerate via run-benchmarks.ps1)
results/*.dmp

# All per-run raw trace/CSV artifacts (regenerate via run-benchmarks.ps1): .nettrace
# captures, per-scenario CSVs, TraceAnalyzer logs/stats, and dotnet-trace launcher logs.
results/raw/

# Per-run benchmark scratch output directories. Only the top-level results/report.html
# and results/results-full.json summaries are tracked; every subdirectory of results/
# (raw, trace, and any experiment/smoke/repro output dir) is regenerated and ignored.
results/*/
results/repro_*.ps1

# Out-of-process trace captures (regenerate via capture-lxr-trace.ps1)
results/trace/
results/phase-report.html

# Local native diagnostic scratch (ad-hoc probes / repro scripts - not part of the GC)
native/*.log
native/dumpwalk.*
native/symres.*
native/gcrepro.ps1
native/hunt.ps1
native/parkstorm.ps1
native/parkdiag*.ps1

# TraceAnalyzer offline tool build output (source under tools/ is tracked)
tools/**/bin/
tools/**/obj/

# Local copy of the LXR paper (arXiv:2210.17175) for offline reference - do not commit
paper/

